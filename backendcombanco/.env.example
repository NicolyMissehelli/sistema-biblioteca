# Copie este arquivo para .env e substitua os valores antes de iniciar a API.
DATABASE_URL=sqlite:///./biblioteca.db
JWT_SECRET=gere-uma-chave-aleatoria-com-openssl
CREATE_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@biblioteca.com
INITIAL_ADMIN_PASSWORD=defina-uma-senha-forte
CORS_ORIGINS=http://localhost:8080
